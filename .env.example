DATABASE_URL=postgresql+asyncpg://orders:orders@127.0.0.1:5434/orders
SQL_ECHO=false

API_HOST=127.0.0.1
API_PORT=8001

CAPASHINO_BASE_URL=https://capashino.dev-2.python-labs.ru
CAPASHINO_API_KEY=replace_me

# После деплоя сюда попадёт внутренний Kubernetes URL.
PAYMENT_CALLBACK_URL=http://order-service.default.svc:8000/api/orders/payment-callback

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_TOPIC=student_system-order.events
KAFKA_SHIPMENT_TOPIC=student_system-shipment.events
KAFKA_GROUP_ID=order-service-capashino
KAFKA_PUBLISH_TIMEOUT=10
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=1
INBOX_BATCH_SIZE=50
INBOX_POLL_INTERVAL=1